{
  "name": "world-clean-biz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run verify:content-classification && npm run generate:image-dimensions",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:analytics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/googleAnalytics.test.mjs",
    "test:lead": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/leadTracking.test.mjs",
    "test:blog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/blogConversion.test.mjs",
    "test:brands": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./tests/register-path-alias.mjs --test tests/brandIntelligence.test.mjs tests/brandExperience.test.mjs",
    "test:equipment": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./tests/register-path-alias.mjs --test tests/equipmentIntelligence.test.mjs tests/equipmentExperience.test.mjs",
    "test:components": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./tests/register-path-alias.mjs --test tests/componentIntelligence.test.mjs tests/componentExperience.test.mjs",
    "test:homepage": "node --test tests/homepageStructure.test.mjs",
    "test:inquiry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/inquiryConversion.test.mjs",
    "test:insights": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/insightCollections.test.mjs",
    "test:blog-landing": "node --test tests/blogLanding.test.mjs",
    "test:seo-audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./tests/register-path-alias.mjs --test tests/seoPerformanceAudit.test.mjs",
    "test:asset-performance": "node --test tests/assetPerformanceAudit.test.mjs",
    "verify:asset-budgets": "node scripts/verify-built-asset-budgets.mjs",
    "generate:image-dimensions": "node scripts/generate-image-dimensions.mjs",
    "verify:sourcing-seo": "node scripts/verify-sourcing-seo.mjs",
    "verify:content-classification": "node scripts/verify-insight-classification.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "0.34.5",
    "typescript": "^5.0.0"
  }
}
